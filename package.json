{
  "name": "my-ai-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "concurrently -n db,api -c magenta,cyan \"npm --prefix server run db\" \"npm --prefix server run dev\"",
    "dev:all": "concurrently -n db,api,web -c magenta,cyan,green \"npm --prefix server run db\" \"npm --prefix server run dev\" \"npm run dev\"",
    "setup": "npm install",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix server install && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "postinstall": "npm --prefix server install"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "lucide-react": "^0.468.0",
    "framer-motion": "^12.0.0",
    "recharts": "^2.15.0",
    "@monaco-editor/react": "^4.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
