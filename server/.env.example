NODE_ENV=development
PORT=8080
# Comma-separated list of allowed frontend origins (any origin is allowed in development)
CLIENT_URL=http://localhost:5173

# Leave empty to use an embedded MongoDB that persists to server/.data (no install needed)
MONGODB_URI=

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: enables "Continue with Google" (also set VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

# Google Gemini (get a key at https://aistudio.google.com/apikey). Without a key, a built-in rule-based engine runs.
# The same key powers resume analysis, questions, evaluation, speech-to-text and text-to-speech.
GEMINI_API_KEY=
# gemini-3.5-flash answers in ~4s; gemini-3.8-flash is smarter but ~15s per call
GEMINI_MODEL=gemini-3.5-flash
# low | medium | high (Gemini 3+). Higher is slower; empty uses the model default (60s+ per call)
GEMINI_THINKING_LEVEL=low
# Speech-to-text model; a lite model has its own free-tier quota (20 requests/day per model on the free tier)
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voices include Kore, Puck, Charon, Aoede, Fenrir
GEMINI_TTS_VOICE=Kore

# Price of one paid interview credit, in INR.
INTERVIEW_PRICE_INR=50
FREE_INTERVIEW_LIMIT=2

# Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys while testing. Empty = demo payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set in Dashboard > Webhooks (events payment.captured, payment.failed) pointing to <api-url>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
